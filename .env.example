# ============================================================
# Multi-Agent Paper Writing System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys and endpoints.
# Model IDs need 'openai/' prefix for litellm to route to OpenAI-compatible APIs.

# --- Draft Agent (起草) ---
DRAFT_MODEL=anthropic/claude-opus-4-6-thinking
DRAFT_API_KEY=sk-your-draft-key
DRAFT_API_BASE=https://your-draft-proxy.com/v1

# --- Review Agent (评审) ---
REVIEW_MODEL=openai/gpt-5.5
REVIEW_API_KEY=sk-your-review-key
REVIEW_API_BASE=https://your-review-proxy.com/v1

# --- Manager Agent (编排) ---
MANAGER_MODEL=openai/gpt-5.5
MANAGER_API_KEY=sk-your-manager-key
MANAGER_API_BASE=https://your-manager-proxy.com/v1

# --- Retrieval LLM (可选:带联网搜索的强模型,如 grok) ---
# 留空 = 关闭网页检索层,只用本地 references/ 笔记和 bibliography。
# 你已提前备好文献时保持留空 —— 这样引用只会来自本地 bib,不会编造。
RETRIEVAL_MODEL=
RETRIEVAL_API_KEY=
RETRIEVAL_API_BASE=

# ============================================================
# 内容源与门禁
# ============================================================

# experiment = 内容源是 data/ 结果库 + idea.md(实验型论文)
# survey     = 内容源是 references/ 文献笔记(综述,对齐原引擎行为)
PAPER_MODE=experiment

# 创新点/原理/方法设计文档的位置。这是 Method/Intro/Related 章的主输入。
# 默认项目根目录的 idea.md;模板见 idea.example.md。
IDEA_PATH=

# 收敛循环:首轮 MUST FIX 冻结成验收单,反复修到全清或到顶
MAX_REVISION_ROUNDS=4
REVIEW_SCORE_THRESHOLD=4.0

# 是否允许从网页补引用。默认 false = 只从本地 bibliography 匹配,绝不编造。
AUTO_CITE_WEB=false
