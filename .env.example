# ============================================================
# Multi-Agent Paper Writing System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys and endpoints.
#
# 模型调用框架（双协议）:
#   - provider=openai    → smolagents OpenAIModel（openai 官方 SDK，OpenAI-compatible）
#   - provider=anthropic → AnthropicModel（anthropic 官方 SDK，自建 /v1/messages）
#
# 关键约定:
#   * provider 由下面的 *_PROVIDER 显式决定，**不再靠 model_id 前缀推断**。
#     同一个 Claude 可能同时暴露 OpenAI-compatible 与 Anthropic-compatible 两套 endpoint，
#     用前缀（anthropic/、openai/…）猜 provider 会产生歧义。
#   * *_MODEL 只填你的网关真正接受的模型 slug，不要带路由前缀。
#     （若你的网关恰好要求 `anthropic/claude-opus-4-6` 这样的 slug，整个字符串作为 model 填入，
#      但这里的 `anthropic/` 是网关 slug 的一部分，不再用于决定 provider。）
#   * *_REASONING_LEVEL 统一 6 档语义：off|low|medium|high|xhigh|max，
#     由框架按模型能力翻译成 provider 原生参数（OpenAI→reasoning_effort；Claude→output_config.effort）。
#     传入模型不支持的档位会**显式报错**，绝不静默降级。

# --- Draft Agent（起草，默认 Claude） ---
DRAFT_PROVIDER=anthropic
DRAFT_MODEL=claude-opus-4-6          # 占位：替换为你的自建 Anthropic-compatible 网关真实 slug
DRAFT_API_KEY=sk-your-draft-key
DRAFT_API_BASE=https://your-anthropic-gateway.example.com
DRAFT_REASONING_LEVEL=max

# --- Review Agent（评审，默认 OpenAI） ---
REVIEW_PROVIDER=openai
REVIEW_MODEL=gpt-5                   # 占位：替换为你的 OpenAI-compatible 网关真实 slug
REVIEW_API_KEY=sk-your-review-key
REVIEW_API_BASE=https://your-openai-proxy.example.com/v1
REVIEW_REASONING_LEVEL=high

# --- Manager Agent（编排，默认 Claude） ---
MANAGER_PROVIDER=anthropic
MANAGER_MODEL=claude-opus-4-6        # 占位：替换为你的自建 Anthropic-compatible 网关真实 slug
MANAGER_API_KEY=sk-your-manager-key
MANAGER_API_BASE=https://your-anthropic-gateway.example.com
MANAGER_REASONING_LEVEL=high

# --- Retrieval LLM (可选:带联网搜索的强模型,如 grok) ---
# 留空 = 关闭网页检索层,只用本地 references/ 笔记和 bibliography。
# 你已提前备好文献时保持留空 —— 这样引用只会来自本地 bib,不会编造。
# 注：retrieval 走原生 urllib、不经模型调用框架，与本文件上面的 *_PROVIDER 体系无关。
RETRIEVAL_MODEL=
RETRIEVAL_API_KEY=
RETRIEVAL_API_BASE=

# --- 模型调用运行时策略 ---
# 单请求超时（秒）；留空 → 按 provider 默认（OpenAI 300 / Claude 600）。
MODEL_TIMEOUT=
# 底层 SDK 客户端层重试次数。瞬时重试已交给 ResilientModel，这里应为 0。
# （见下方 LLM_RETRY_*；保持 0 可避免多层重试放大成不可解释的空窗。）
MODEL_MAX_RETRIES=0
# Anthropic 最大输出 token 数（/v1/messages 强制要求）。
ANTHROPIC_MAX_TOKENS=16384

# --- ResilientModel 瞬时重试（midstream fast reconnect）---
# 网关对 reasoning 长流式不稳，会在响应中途 RST/503。ResilientModel 在 Model 层用
# atomic buffer 收完整个流，断了就丢弃 partial、快速重发同一请求，避免整个
# CodeAgent.run() 重跑几分钟。这里配置是"单次 logical call"内的重试。
LLM_RETRY_ENABLED=true
LLM_RETRY_MAX_ATTEMPTS=3      # 一个 logical call 最多尝试 3 次（含首次）
LLM_RETRY_DELAY_1=0.8         # 第 1 次失败后等待秒数（±jitter）
LLM_RETRY_DELAY_2=2.0         # 第 2 次失败后等待秒数（±jitter）
LLM_RETRY_JITTER_RATIO=0.25   # 退避抖动比例，避免多 worker 同步重试
LLM_FAST_RETRY_AFTER_CAP=15   # 服务端 Retry-After 超过此值则不再快速重试，交给 stage 兜底

# ============================================================
# 内容源与门禁
# ============================================================

# experiment = 内容源是 data/ 结果库 + idea.md(实验型论文)
# survey     = 内容源是 references/ 文献笔记(综述,对齐原引擎行为)
PAPER_MODE=experiment

# 创新点/原理/方法设计文档的位置。这是 Method/Intro/Related 章的主输入。
# 默认项目根目录的 idea.md;模板见 idea.example.md。
IDEA_PATH=

# 收敛循环:首轮 MUST FIX 冻结成验收单,反复修到全清或到顶
MAX_REVISION_ROUNDS=4
REVIEW_SCORE_THRESHOLD=4.0

# 是否允许从网页补引用。默认 false = 只从本地 bibliography 匹配,绝不编造。
AUTO_CITE_WEB=false
